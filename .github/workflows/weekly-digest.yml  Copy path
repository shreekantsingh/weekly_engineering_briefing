
name: Weekly Engineering Digest

on:
  schedule:
    # Every Monday at 09:00 AM IST (03:30 UTC)
    - cron: "30 3 * * 1"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  send-digest:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: python -m pip install --upgrade requests

      - name: Generate and email digest
        env:
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          DIGEST_EMAIL: ${{ vars.DIGEST_EMAIL }}
          DIGEST_FROM: ${{ vars.DIGEST_FROM }}
        run: python weekly_engineering_briefing.py
